# Groq Cloud - https://console.groq.com
GROQ_API_KEY=

# Optional. Overrides the default model, openai/gpt-oss-120b
GROQ_MODEL=

# Tavily - https://tavily.com  (reached through the remote Tavily MCP server)
TAVILY_API_KEY=

# AviationStack - https://aviationstack.com/signup/free
AVIATIONSTACK_API_KEY=

# OpenWeatherMap - https://openweathermap.org/api  (used by weather_mcp_server.py)
OPENWEATHER_API_KEY=

# PostgreSQL, used for LangGraph checkpoints and conversation memory
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/langgraph_memory_demo
